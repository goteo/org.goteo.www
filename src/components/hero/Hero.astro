---
import heroImage from "./hero.png";
import Grid from "../library/layout/Grid.svelte";
import { renderMarkdown } from "../../utils/renderMarkdown";

import type { HomeHeroRecord } from "../../repositories/homeHero";

interface Props {
    hero?: HomeHeroRecord | null;
}

const { hero } = Astro.props;
const { t } = Astro.locals;

// Authored in the admin as Markdown. Only ROLE_ADMIN can write it.
const content = hero ? await renderMarkdown(hero.content) : null;
const isVideo = hero?.mediaType?.startsWith("video/") ?? false;
---

<section class="wrapper hero-section flex">
    <div class="container mx-auto py-16 lg:py-24">
        <Grid class="grid-cols-1 items-center gap-12 lg:grid-cols-2" client:load>
            <!-- Hero Content -->
            <div class="space-y-8">
                <h1 class="text-secondary text-4xl leading-tight font-bold lg:text-5xl xl:text-6xl">
                    {hero?.title ?? t("pages.hero.title")}
                </h1>

                {
                    content ? (
                        <div
                            class="marked-content space-y-1 text-lg leading-relaxed text-neutral-500"
                            set:html={content}
                        />
                    ) : (
                        <div class="space-y-1 text-lg leading-relaxed text-neutral-500">
                            {t("pages.hero.description", {}, { allowHTML: true })}
                        </div>
                    )
                }

                <!-- CTA Buttons -->
                <div class="flex flex-col gap-4 sm:flex-row">
                    {
                        hero?.primaryCtaText && hero.primaryCtaLink && (
                            <a
                                href={hero.primaryCtaLink}
                                class="text-secondary bg-purple-soft inline-block rounded-full border-0 px-8 py-4 text-center font-semibold whitespace-nowrap transition-all duration-200 hover:opacity-90"
                            >
                                {hero.primaryCtaText}
                            </a>
                        )
                    }
                    {
                        hero?.secondaryCtaText && hero.secondaryCtaLink && (
                            <a
                                href={hero.secondaryCtaLink}
                                class="bg-primary text-secondary inline-block rounded-full border-0 px-8 py-4 text-center font-semibold whitespace-nowrap transition-all duration-200 hover:opacity-90"
                            >
                                {hero.secondaryCtaText}
                            </a>
                        )
                    }
                </div>
            </div>

            <!-- Hero Illustration -->
            <div class="relative flex justify-center lg:justify-end">
                <!-- Aspect is pinned so the box is reserved before a remote asset loads. -->
                <div class="relative aspect-[668/510] w-full max-w-lg">
                    {
                        hero?.mediaUrl ? (
                            isVideo ? (
                                <video
                                    src={hero.mediaUrl}
                                    autoplay
                                    muted
                                    loop
                                    playsinline
                                    class="h-full w-full scale-120 object-contain"
                                />
                            ) : (
                                <img
                                    src={hero.mediaUrl}
                                    alt={hero.title}
                                    class="h-full w-full scale-120 object-contain"
                                />
                            )
                        ) : (
                            <img
                                src={heroImage.src}
                                width={heroImage.width}
                                height={heroImage.height}
                                alt="Hero Illustration"
                                class="h-full w-full scale-120 object-contain"
                            />
                        )
                    }
                </div>
            </div>
        </Grid>
    </div>
</section>
