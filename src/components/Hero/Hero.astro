---
import heroImage from "./hero.png";
import Grid from "../library/Grid.svelte";

const { t } = Astro.locals;
---

<section class="wrapper hero-section flex">
    <div class="container mx-auto py-16 lg:py-24">
        <Grid class="grid-cols-1 items-center gap-12 lg:grid-cols-2" client:load>
            <!-- Hero Content -->
            <div class="space-y-8">
                <h1 class="text-secondary text-4xl leading-tight font-bold lg:text-5xl xl:text-6xl">
                    {t("pages.hero.title")}
                </h1>

                <div class="space-y-1 text-lg leading-relaxed text-neutral-500">
                    {t("pages.hero.description", {}, { allowHTML: true })}
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col gap-4 sm:flex-row">
                    <!-- <button
                        class="text-secondary bg-purple-soft rounded-full border-0 px-8 py-4 font-semibold whitespace-nowrap transition-all duration-200 hover:opacity-90"
                    >
                        {t("pages.hero.buttons.discover")}
                    </button>
                    <button
                        class="bg-primary text-secondary rounded-full border-0 px-8 py-4 font-semibold whitespace-nowrap transition-all duration-200 hover:opacity-90"
                    >
                        {t("pages.hero.buttons.impulse")}
                    </button> -->
                </div>
            </div>

            <!-- Hero Illustration -->
            <div class="relative flex justify-center lg:justify-end">
                <div class="relative w-full max-w-lg">
                    <img
                        src={heroImage.src}
                        alt="Hero Illustration"
                        class="h-auto w-full scale-120"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            </div>
        </Grid>
    </div>
</section>
