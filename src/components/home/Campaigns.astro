---
import CampaignCard from "./CampaignCard.svelte";
import type { Campaign } from "../../types/campaign";
import Arrow from "../../components/icons/navigation/Arrow.svelte";
import { apiAccountingsIdGet, apiProjectsGetCollection, type Money } from "../../openapi/client";
import { getLanguage } from "../../middleware/utils";
import Grid from "../library/layout/Grid.svelte";
import Button from "../library/buttons/Button.svelte";
import { extractId } from "../../utils/extractId";
import { highlightRepository } from "../../repositories/highlights";

const { t } = Astro.locals;

const { highlight, slots } = await highlightRepository.get();

if (!highlight || slots.length === 0) {
    return;
}

const slugs = slots.sort((a, b) => a.position - b.position).map((s) => s.projectSlug);

const { data: projects } = await apiProjectsGetCollection({
    headers: { "Accept-Language": getLanguage(Astro) },
    query: {
        "slug[]": slugs,
    },
});

const LAYOUT_SIZES: Record<string, ("large" | "small")[]> = {
    "2x3": ["large", "small", "small", "small", "small", "small"],
    "2x2": ["large", "small", "small", "large"],
    "3x2": ["small", "small", "small", "small", "large"],
    "3x3": ["small", "small", "small", "small", "small", "small"],
};

const sizeMap = LAYOUT_SIZES[highlight.layout] ?? LAYOUT_SIZES["2x3"];

const projectBySlug = new Map((projects || []).map((p) => [p.slug, p]));

const existingSlugs = slugs.filter((slug) => projectBySlug.has(slug));

const campaigns = await Promise.all(
    existingSlugs.map(async (slug, index) => {
        const project = projectBySlug.get(slug)!;

        const { data: accounting } = await apiAccountingsIdGet({
            path: { id: extractId(project.accounting)! },
        });

        return {
            ...project,
            size: sizeMap[index] ?? "small",
            slug: project.slug!,
            title: project.title!,
            image:
                project.video?.thumbnail! ||
                project.cover!,
            minimum: project.budget?.minimum?.money!,
            obtained: accounting!.balance as Money,
            optimum: project.budget?.optimum?.money,
        } satisfies Campaign;
    }),
);
---

<section class="wrapper">
    <!-- Header Section -->
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-black">
            {t("pages.home.campaigns.title")}
        </h2>

        <!-- "View All" Button -->
        <a href="/search" aria-label={t("pages.home.campaigns.viewAll")}>
            <Button client:load kind="secondary" size="md">
                <Arrow />
                <span class="text-secondary text-base font-bold">
                    {t("pages.home.campaigns.viewAll")}
                </span>
            </Button>
        </a>
    </div>

    <!-- Campaigns Grid: 3 columns max, 2 rows, large cards take 2 columns -->
    <Grid class="auto-rows-fr grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" client:load>
        {
            campaigns.map((campaign) => (
                <CampaignCard size={campaign.size ?? "small"} campaign={campaign} client:load />
            ))
        }
    </Grid>
</section>
