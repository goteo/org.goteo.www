---
import type { Promoter } from "../../types/promoter";
import ShareIcon from "../icons/Share.svelte";

export interface Props {
    promoter: Promoter;
}

const { promoter } = Astro.props;
const { t } = Astro.locals;
---

<div class="relative overflow-hidden rounded-3xl bg-white shadow-lg">
    <!-- Decorative background with gradient and shapes -->
    <div class="bg-secondary relative h-97.25 overflow-hidden rounded-t-3xl">
        <!-- Gradient background -->
        <div class="from-primary/30 to-tertiary absolute inset-0 bg-gradient-to-br"></div>

        <!-- Decorative SVG elements -->
        <div class="absolute top-34 -left-18.75 h-87.75 w-87.75 opacity-20">
            <img
                src="/images/home/promoter-decoration-2.svg"
                alt=""
                class="h-full w-full object-contain"
                aria-hidden="true"
            />
        </div>
        <div class="absolute -top-41.75 left-43.25 h-94.25 w-94.25 opacity-15">
            <img
                src="/images/home/promoter-decoration-3.svg"
                alt=""
                class="h-full w-full object-contain"
                aria-hidden="true"
            />
        </div>
        <div class="absolute top-46.75 left-36 h-69.5 w-69.5 opacity-10">
            <img
                src="/images/home/promoter-decoration-4.svg"
                alt=""
                class="h-full w-full object-contain"
                aria-hidden="true"
            />
        </div>
        <div class="absolute -top-15.75 -left-26.25 h-69.5 w-69.5 opacity-10">
            <img
                src="/images/home/promoter-decoration-4.svg"
                alt=""
                class="h-full w-full object-contain"
                aria-hidden="true"
            />
        </div>

        <!-- Main promoter image -->
        <div
            class="absolute inset-0 bg-cover bg-center bg-no-repeat"
            style={`background-image: url('${promoter.image}')`}
            role="img"
            aria-label={`${promoter.name} - ${t("pages.home.featuredPromoters.promoterImage")}`}
        >
        </div>

        <!-- Decorative path overlay -->
        <div class="absolute -top-28 -right-32.75 h-139.75 w-98.75 opacity-30">
            <img
                src="/images/home/promoter-decoration-1.svg"
                alt=""
                class="h-full w-full object-contain"
                aria-hidden="true"
            />
        </div>
    </div>

    <!-- Share button -->
    <!-- <button
        class="bg-white border-grey absolute top-[325px] right-6 flex h-10 w-10 items-center justify-center rounded-full border shadow-md transition-all duration-200 hover:bg-white hover:shadow-lg"
        aria-label={t("pages.home.featuredPromoters.shareProfile", { name: promoter.name })}
    >
        <ShareIcon />
    </button> -->

    <!-- Content area -->
    <div class="flex flex-col gap-6 p-6">
        <!-- Name -->
        <h3 class="text-secondary text-2xl leading-8 font-bold">
            {promoter.name}
        </h3>

        <!-- Stats -->
        <div class="flex items-center justify-between">
            <!-- Projects promoted -->
            <div class="flex flex-col gap-1 text-left">
                <span class="text-content text-base leading-6">
                    {t("pages.home.featuredPromoters.projectsPromoted")}
                </span>
                <span class="text-content text-2xl leading-8 font-bold">
                    {promoter.projectsPromoted}
                </span>
            </div>

            <!-- Capital raised -->
            <div class="flex flex-col gap-1 text-right">
                <span class="text-content text-base leading-6">
                    {t("pages.home.featuredPromoters.capitalRaised")}
                </span>
                <span class="text-content text-2xl leading-8 font-bold">
                    {promoter.capitalRaised}
                </span>
            </div>
        </div>
    </div>
</div>
