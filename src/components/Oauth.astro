---
import GoogleIcon from "./icons/social/GoogleIcon.astro";
import FacebookIcon from "./icons/social/FacebookIcon.astro";
import XIcon from "./icons/social/XIcon.astro";
import LinkedinIcon from "./icons/social/LinkedinIcon.astro";

const providers = [
    { icon: GoogleIcon },
    { icon: XIcon },
    { icon: FacebookIcon },
    { icon: LinkedinIcon },
];
---

<div class="flex w-full flex-row gap-4">
    {
        providers.map(({ icon: Icon }) => (
            <a
                href="#"
                class="flex items-center justify-center rounded-xl border border-gray-200 p-4.5"
            >
                <Icon />
            </a>
        ))
    }
</div>
