---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import AdminSidebar, { type AdminSidebarItem } from "../../../components/admin/AdminSidebar.svelte";
import AdminNewsletter from "../../../components/admin/Newsletter.svelte";

const { t, lang, session } = Astro.locals;

const navItems: AdminSidebarItem[] = [
    { label: t("pages.admin.newsletter.title"), href: "/admin/newsletter" }
];

const activePath = "/admin/newsletter";
---

<Layout title={t("pages.admin.newsletter.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang} session={session} admin>
        <div class="wrapper">
            <div class="flex w-full gap-8 py-10">
                <AdminSidebar {navItems} {activePath} client:load />

                <main class="min-w-0 flex-1">
                    <AdminNewsletter client:load />
                </main>
            </div>
        </div>
    </App>
</Layout>
