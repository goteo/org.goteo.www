---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import AdminProjects from "../../../components/admin/projects/Projects.svelte";

const { t, lang, session } = Astro.locals;
---

<Layout title={t("pages.admin.projects.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang} session={session} admin>
        <AdminProjects client:load />
    </App>
</Layout>
