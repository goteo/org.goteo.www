---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import WithSidebar from "../../../layouts/WithSidebar.svelte";
import Comm from "../../../components/admin/comm/Comm.svelte";

const { t, lang, session } = Astro.locals;
const activePath = "/admin/comm";

const navItems: { label: string; href: string }[] = [
	{ label: t("pages.admin.comm.tabs.banners"), href: "/admin/comm#banners" },
];
---

<Layout title={t("pages.admin.comm.title")} description={t("pages.metadata.description")}>
	<App client:load locale={lang} session={session} admin>
		<WithSidebar client:load {navItems} {activePath}>
			<Comm client:load />
		</WithSidebar>
	</App>
</Layout>
