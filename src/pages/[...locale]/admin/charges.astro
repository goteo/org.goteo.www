---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import AdminCharges from "../../../components/admin/charges/Charges.svelte";

const { t, lang, session } = Astro.locals;
---

<Layout title={t("pages.admin.charges.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang} session={session} admin>
        <AdminCharges client:load />
    </App>
</Layout>
