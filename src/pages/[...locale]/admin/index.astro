---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import Arrow from "../../../components/icons/navigation/Arrow.svelte";
import Title from "../../../components/library/typography/Title.svelte";
import { ADMIN_SECTIONS } from "../../../components/admin/adminSections";

const { lang, t, session } = Astro.locals;

const sections = ADMIN_SECTIONS.map((section) => ({
    title: t(section.labelKey),
    description: section.descriptionKey ? t(section.descriptionKey) : undefined,
    href: `/${lang}${section.href}`,
    subLinks: section.subSections?.map((link) => ({
        label: t(link.labelKey),
        href: `/${lang}${link.href}`,
    })),
}));
---

<Layout title={t("pages.admin.landing.title")} description={t("pages.metadata.description")}>
    <App client:load locale={lang} session={session} admin>
        <div class="wrapper">
            <div class="flex w-full flex-col gap-10 py-10">
                <header class="flex flex-col gap-4">
                    <Title level={2} variant="headline" weight="bold" color="default">
                        {t("pages.admin.landing.title")}
                    </Title>
                    <p class="text-content font-body text-base leading-6">
                        {t("pages.admin.landing.subtitle")}
                    </p>
                </header>

                <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {
                        sections.map((section) => (
                            <li class="border-grey flex flex-col gap-4 rounded-4xl border bg-white p-6 shadow-sm transition hover:shadow-md">
                                <a
                                    href={section.href}
                                    class="text-secondary group inline-flex items-center justify-between gap-4 text-xl font-bold transition duration-300 hover:opacity-70"
                                >
                                    {section.title}
                                    <Arrow class="size-5 transition-all duration-300 group-hover:-rotate-45" />
                                </a>
                                <p class="text-content text-sm leading-relaxed">
                                    {section.description}
                                </p>
                                {section.subLinks && section.subLinks.length > 0 && (
                                    <ul class="border-grey mt-auto flex flex-col gap-1 border-t pt-3">
                                        {section.subLinks.map((link) => (
                                            <li>
                                                <a
                                                    href={link.href}
                                                    class="text-secondary text-base font-medium transition hover:opacity-70"
                                                >
                                                    {link.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </App>
</Layout>
