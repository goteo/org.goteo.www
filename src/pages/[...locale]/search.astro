---
import Layout from "../../layouts/Layout.astro";
import App from "../../layouts/App.svelte";
import SearchFilters from "../../components/search/SearchFilters.svelte";
import SearchResultsClient from "../../components/search/SearchResultsClient.svelte";
import { parseSearchParamsFilters } from "../../stores/searchStore";

import type { Project } from "../../openapi/client/types.gen";

const { t, lang } = Astro.locals;

// Initial projects will be fetched client-side to avoid blocking SSR
const initialProjects: Project[] = [];

const url = new URL(Astro.request.url);
const initialFilters = parseSearchParamsFilters(url.searchParams);

// Check if URL has search parameters
const hasInitialSearch = Object.entries(initialFilters).length > 0;
---

<Layout title={t("pages.search.title")} description={t("pages.search.description")}>
    <App client:load locale={lang}>
        <section class="wrapper">
            <!-- Page Header -->
            <div class="mb-12 text-center">
                <h1 class="text-secondary mb-4 text-4xl font-bold">
                    {t("pages.search.heading")}
                </h1>
                <p class="text-secondary text-lg">
                    {t("pages.search.subtitle")}
                </p>
            </div>

            <!-- Search Filters -->
            <div class="mb-8">
                <SearchFilters initialFilters={initialFilters} client:load />
            </div>

            <!-- Search Results -->
            <div class="mb-8" role="region" aria-label={t("pages.search.results.regionLabel")}>
                <SearchResultsClient
                    initialProjects={initialProjects}
                    initialFilters={initialFilters}
                    hasInitialSearch={hasInitialSearch}
                    client:load
                />
            </div>
        </section>
    </App>
</Layout>
