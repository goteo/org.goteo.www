---
import Layout from "../../../../../layouts/Layout.astro";
import { apiProjectsIdOrSlugGet, apiProjectsIdPatch } from "../../../../../openapi/client";
import App from "../../../../../layouts/App.svelte";
import ProjectEditor from "./ProjectEditor.svelte";
import { goto } from "../../../../../utils/navigation";

const { t, lang: locale } = Astro.locals;

const { idOrSlug } = Astro.params;
if (!idOrSlug) {
    return Astro.redirect("/500");
}

const { session } = Astro.locals;
if (!session) {
    const requestUrl = new URL(Astro.request.url);
    const callbackURL = requestUrl.pathname + requestUrl.search;
    return goto("/login", { query: { callback: callbackURL } });
}

const { data: project } = await apiProjectsIdOrSlugGet({
    path: { idOrSlug },
    headers: session.token.asHttpHeaders,
});

if (project?.id) {
    const { error, request } = await apiProjectsIdPatch({
        path: { id: String(project.id) },
        body: { id: project.id },
        headers: session.token.asHttpHeaders,
    });

    if (error) {
        console.error({ error, request });
        return Astro.redirect("/404");
    }
}
---

<Layout title={t("pages.project.edit.title", { project: project?.title ?? "" })}>
    <App locale={locale} session={session} client:load>
        <ProjectEditor idOrSlug={idOrSlug} project={project} client:load />
    </App>
</Layout>
