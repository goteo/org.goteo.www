---
import Layout from "../../../../../layouts/Layout.astro";
import { apiProjectsIdOrSlugGet, apiProjectsIdPatch } from "../../../../../openapi/client";
import App from "../../../../../layouts/App.svelte";
import ProjectEditorShell from "../../../../../components/project/edit/ProjectEditorShell.svelte";
import { goto } from "../../../../../utils/navigation";
import { NotFound, Unauthorized, Forbidden } from "../../../../../utils/responses";

const { t, lang: locale } = Astro.locals;

const { idOrSlug } = Astro.params;
if (!idOrSlug) {
    return Astro.redirect("/500");
}

const { session } = Astro.locals;
if (!session) {
    const requestUrl = new URL(Astro.request.url);
    return goto("/login", { query: { callback: requestUrl.pathname + requestUrl.search } });
}

const { data: projectFromApi, error: getError } = await apiProjectsIdOrSlugGet({
    headers: { ...session.token.asHttpHeaders, "Accept-Language": locale },
    path: { idOrSlug },
});

if (getError && getError.status !== NotFound.status) {
    console.error({ project: projectFromApi, error: getError });
    return Astro.rewrite("/500");
}

if (projectFromApi) {
    const { request, error: patchError } = await apiProjectsIdPatch({
        headers: { ...session.token.asHttpHeaders, "Accept-Language": locale },
        path: { id: String(projectFromApi.id) },
        body: { id: projectFromApi.id },
    });

    if (patchError) {
        if ([Unauthorized.status, Forbidden.status].includes(patchError.status!)) {
            return Astro.rewrite("/403");
        }

        console.error({ request, error: patchError });
        return Astro.rewrite("/500");
    }
}
---

<Layout title={t("pages.project.edit.title", { project: projectFromApi?.title! })}>
    <App locale={locale} session={session} client:load>
        <ProjectEditorShell key={idOrSlug} actor={session.user} project={projectFromApi} client:load />
    </App>
</Layout>
