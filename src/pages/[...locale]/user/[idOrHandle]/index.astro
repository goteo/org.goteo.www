---
import User from "./User.svelte";
import Layout from "../../../../layouts/Layout.astro";
import App from "../../../../components/App.svelte";
import {
    apiUsersIdOrHandleGet,
    apiProjectSupportsGetCollection,
    apiProjectSupportsmoneyTotalGetCollection,
    apiProjectsGetCollection,
} from "../../../../openapi/client";
import type { Accounting, Money, ProjectSupport } from "../../../../openapi/client";
import type { Campaign } from "../../../../types/campaign";
import { client } from "../../../../openapi/client/client.gen";
import { getLanguage } from "../../../../middleware/utils";

const { idOrHandle } = Astro.params;
const { lang, session } = Astro.locals;

if (!idOrHandle) {
    return Astro.redirect("/404");
}

const { data: user, error } = await apiUsersIdOrHandleGet({
    path: { idOrHandle },
});

if (error || !user) {
    return Astro.redirect("/404");
}

if (!user.accounting) {
    throw new Error(`User ${idOrHandle} has no Accounting`);
}

let userSupports: ProjectSupport[] = [];
let totalDonated = { amount: 0, currency: import.meta.env.PUBLIC_DEFAULT_CURRENCY as string };
let projectsDonatedCount = 0;

try {
    const { data: supports } = await apiProjectSupportsGetCollection({
        query: { origin: user.accounting },
    });

    userSupports = supports ?? [];
    projectsDonatedCount = userSupports.length;

    if (userSupports.length > 0) {
        const { data: moneyTotal } = await apiProjectSupportsmoneyTotalGetCollection({
            query: { origin: user.accounting },
        });

        if (moneyTotal?.amount && moneyTotal?.currency) {
            totalDonated = {
                amount: Number(moneyTotal.amount),
                currency: moneyTotal.currency,
            };
        }
    }
} catch (e) {
    console.error("Error fetching user supports:", e);
}

const slugs = userSupports
    .slice(0, 10)
    .map((s) => s.project?.split("/").at(-1))
    .filter(Boolean) as string[];

let campaigns: Campaign[] = [];

if (slugs.length > 0) {
    try {
        const { data: projects } = await apiProjectsGetCollection({
            query: { "slug[]": slugs },
            headers: { "Accept-Language": getLanguage(Astro) },
        });

        if (projects) {
            campaigns = (
                await Promise.all(
                    projects.map(async (project) => {
                        try {
                            const { data: accounting } = (await client.get({
                                url: client.buildUrl({ url: project.accounting! }),
                            })) as { data: Accounting };

                            return {
                                ...project,
                                slug: project.slug!,
                                title: project.title!,
                                image: project.video?.thumbnail ?? "",
                                minimum: project.budget?.minimum?.money as Money,
                                obtained: accounting!.balance as Money,
                                optimum: project.budget?.optimum?.money as Money | undefined,
                                size: "small",
                            } as Campaign;
                        } catch (e) {
                            console.error(`Error fetching project ${project.slug}:`, e);
                            return null;
                        }
                    }),
                )
            ).filter(Boolean) as Campaign[];
        }
    } catch (e) {
        console.error("Error fetching projects:", e);
    }
}
---

<Layout title={user.displayName ?? user.handle} description={user.handle}>
    <App client:load locale={lang} session={session} class="mt-0 pb-20">
        <User
            {user}
            {campaigns}
            projectsDonated={projectsDonatedCount}
            moneyDonatedAmount={totalDonated.amount}
            moneyDonatedCurrency={totalDonated.currency}
            client:load
        />
    </App>
</Layout>
