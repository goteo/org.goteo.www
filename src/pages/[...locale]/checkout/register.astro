---
import Layout from "../../../layouts/Layout.astro";
import RegisterForm from "../../../components/RegisterForm.svelte";

const { lang, session } = Astro.locals;
const { t } = Astro.locals;
---

<Layout title={t("pages.register.metadata.title")}>
    <main class="bg-grey min-h-screen w-full overflow-visible">
        <RegisterForm client:load lang={lang} session={session} />
    </main>
</Layout>
