---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import { apiAccountingsIdGet, apiGatewayCheckoutsIdGet } from "../../../openapi/client/index.ts";
import FeedbackForm from "../../../components/checkout/FeedbackForm.svelte";
import Summary from "../../../components/checkout/Summary.svelte";
import PaymentMethod from "../../../components/checkout/PaymentMethod.astro";
import { apiGatewaysGetCollection } from "../../../openapi/client/index";
import Card from "../../../components/library/cards/Card.svelte";
import { extractId } from "../../../utils/extractId.ts";
import { sumMoney } from "../../../utils/money";
import type { Money } from "../../../openapi/client";

const { t, lang, session } = Astro.locals;

const { data: paymentGateways } = await apiGatewaysGetCollection();

if (!session) {
    return Astro.redirect("/login?callback=/checkout/verify" + Astro.url.searchParams);
}

const { token, user } = session;

const { data: accounting } = await apiAccountingsIdGet({
    path: { id: extractId(user.accounting)! },
    headers: {
        Authorization: `${token.token_type} ${token.access_token}`,
    },
});

let error = null;
let amount: number | undefined = undefined;
let selectedGateway: string | undefined = undefined;

try {
    const url = new URL(Astro.request.url);
    const checkoutId = url.searchParams.get("checkoutId");

    if (!checkoutId) {
        throw new Error("Checkout ID not found");
    }

    const response = await apiGatewayCheckoutsIdGet({
        path: { id: checkoutId },
        headers: {
            Authorization: `Bearer ${token}`,
        },
    });

    if (!response.data) {
        throw new Error("Data not found");
    }

    selectedGateway = response.data.gateway.split("/").pop();

    if (response.data.status !== "charged") {
        throw new Error("Payment not completed");
    }

    amount = response.data?.charges?.length
        ? sumMoney(response.data.charges.filter((c) => c.money).map((c) => c.money! as Money))
              .amount
        : undefined;
} catch (err) {
    console.error("Error trying to get payment status", err);
    error = err instanceof Error ? err.message : "Unknown error";
}

const checkoutId = new URL(Astro.request.url).searchParams.get("checkoutId");
const postPaymentUrl = checkoutId
    ? `/checkout/post-payment?checkoutId=${checkoutId}`
    : "/checkout/post-payment";
---

<Layout title="Estado del pago">
    <App client:load locale={lang} session={session}>
        <div class="wrapper pt-6 max-md:px-0">
            {
                error ? (
                    <div class="wrapper max-md:px-0">
                        <div class="flex flex-col gap-8 pt-6 lg:flex-row">
                            <div class="flex w-full flex-col gap-10 px-4 lg:w-1/2 lg:px-0">
                                <div class="flex flex-col gap-4">
                                    <div class="flex flex-col gap-10">
                                        <div class="flex flex-row items-center justify-between gap-6">
                                            <div class="flex w-2/3 flex-col gap-4">
                                                <h2 class="text-[2.5rem]/12 font-bold tracking-[0%] text-black">
                                                    {t("pages.checkout.verify.error.title")}
                                                </h2>
                                                <p class="text-content">
                                                    {t("pages.checkout.verify.error.description")}
                                                </p>
                                            </div>
                                            <img
                                                src="/images/checkout/payment-error.svg"
                                                alt=""
                                                width="221"
                                                height="214"
                                            />
                                        </div>

                                        <PaymentMethod
                                            {paymentGateways}
                                            {accounting}
                                            hasError={!!error}
                                        />
                                    </div>
                                </div>
                            </div>
                            <Card class="lg: sticky -bottom-6 flex h-fit w-full flex-col items-start gap-6 rounded-3xl border-black pr-4 pb-10 pl-4 lg:top-(--sticky-top) lg:bottom-auto lg:w-1/2 lg:gap-6 lg:rounded-[40px] lg:p-6">
                                <Summary client:load hasError={!!error} />
                                <div class="w-full lg:block" id="checkout-details">
                                    <div class="flex flex-col">
                                        <p class="text-content text-sm">
                                            {t("pages.checkout.summary.deduct")}
                                        </p>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <a
                                        href={postPaymentUrl}
                                        class="bg-primary text-secondary w-fit cursor-pointer rounded-3xl px-6 py-4 font-bold"
                                    >
                                        {t("common.continue")}
                                    </a>
                                </div>
                            </Card>
                        </div>
                    </div>
                ) : (
                    <>
                        <div class="wrapper max-md:px-0">
                            <div class="flex flex-col gap-8 pt-6 lg:flex-row">
                                <div class="flex w-full flex-col gap-10 px-4 lg:w-1/2 lg:px-0">
                                    <div class="flex flex-col gap-4">
                                        <div class="flex flex-col gap-9">
                                            <div class="flex flex-row items-center justify-between gap-6">
                                                <div class="flex w-2/3 flex-col gap-4">
                                                    <h2 class="text-[2.5rem]/12 font-bold tracking-[0%] text-black">
                                                        {t("pages.checkout.verify.approved.title")}
                                                    </h2>
                                                    <p class="text-content">
                                                        {t(
                                                            "pages.checkout.verify.approved.description",
                                                        )}
                                                    </p>
                                                </div>
                                                <img
                                                    src="/images/checkout/payment-approved.svg"
                                                    alt=""
                                                    width="215"
                                                    height="190"
                                                />
                                            </div>
                                            <div>
                                                <FeedbackForm
                                                    client:load
                                                    paymentMethod={selectedGateway}
                                                />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <Card class="lg: sticky -bottom-6 flex h-fit w-full flex-col items-start gap-6 rounded-3xl border-black pr-4 pb-10 pl-4 lg:top-(--sticky-top) lg:bottom-auto lg:w-1/2 lg:gap-6 lg:rounded-[40px] lg:p-6">
                                    <Summary client:load hasError={!!error} />
                                    <div class="w-full lg:block" id="checkout-details">
                                        <div class="flex flex-col">
                                            <p class="text-content text-sm">
                                                {t("pages.checkout.summary.deduct")}
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-end">
                                        <a
                                            href={postPaymentUrl}
                                            class="bg-primary text-secondary w-fit cursor-pointer rounded-3xl px-6 py-4 font-bold"
                                        >
                                            {t("common.continue")}
                                        </a>
                                    </div>
                                </Card>
                            </div>
                        </div>
                        <script>import {cart} from "../../../stores/cart"; cart.clear();</script>
                    </>
                )
            }
        </div>
    </App>
</Layout>
