---
import Layout from "../../../layouts/Layout.astro";
import App from "../../../layouts/App.svelte";
import {
    apiAccountingsIdGet,
    apiGatewayCheckoutsIdGet,
    apiProjectSupportsGetCollection,
    apiProjectsGetCollection,
    apiProjectsIdOrSlugGet,
} from "../../../openapi/client/index.ts";
import FeedbackForm from "../../../components/checkout/FeedbackForm.svelte";
import Summary from "../../../components/checkout/Summary.svelte";
import PaymentMethod from "../../../components/checkout/PaymentMethod.astro";
import { apiGatewaysGetCollection } from "../../../openapi/client/index";
import Card from "../../../components/library/cards/Card.svelte";
import { extractId } from "../../../utils/extractId.ts";
import { sumMoney } from "../../../utils/money";
import type { Money, Project, ProjectSupport } from "../../../openapi/client";
import { goto } from "../../../utils/navigation";
import { client } from "../../../openapi/client/client.gen";
import { apiProjectsIdOrSlugGetUrl } from "../../../openapi/client/paths.gen";

const { t } = Astro.locals;

const { accounting, paymentGateways, selectedGateway, postPaymentUrl } = Astro.props;
---

<div class="wrapper max-md:px-0">
    <div class="flex flex-col gap-8 pt-6 lg:flex-row">
        <div class="flex w-full flex-col gap-10 px-4 lg:w-1/2 lg:px-0">
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-10">
                    <div class="flex flex-row items-center justify-between gap-6">
                        <div class="flex w-2/3 flex-col gap-4">
                            <h2 class="text-[2.5rem]/12 font-bold tracking-[0%] text-black">
                                {t("pages.checkout.verify.error.title")}
                            </h2>
                            <p class="text-content">
                                {t("pages.checkout.verify.error.description")}
                            </p>
                        </div>
                        <img
                            src="/images/checkout/payment-error.svg"
                            alt=""
                            width="221"
                            height="214"
                        />
                    </div>

                    <PaymentMethod
                        {accounting}
                        {paymentGateways}
                        {selectedGateway}
                        hasError={true}
                    />
                </div>
            </div>
        </div>
        <Card
            class="lg: sticky -bottom-6 flex h-fit w-full flex-col items-start gap-6 rounded-3xl border-black pr-4 pb-10 pl-4 lg:top-(--sticky-top) lg:bottom-auto lg:w-1/2 lg:gap-6 lg:rounded-[40px] lg:p-6"
        >
            <Summary client:load hasError={true} />
            <div class="w-full lg:block" id="checkout-details">
                <div class="flex flex-col">
                    <p class="text-content text-sm">
                        {t("pages.checkout.summary.deduct")}
                    </p>
                </div>
            </div>
            <div class="flex flex-col items-end">
                <a
                    href={postPaymentUrl}
                    class="bg-primary text-secondary w-fit cursor-pointer rounded-3xl px-6 py-4 font-bold"
                >
                    {t("common.continue")}
                </a>
            </div>
        </Card>
    </div>
</div>
