---
import Layout from "../../../layouts/Layout.astro";
import LoginForm from "../../../components/LoginForm.svelte";

const { lang, session } = Astro.locals;
const { t } = Astro.locals;
---

<Layout title={t("pages.login.metadata.title")}>
    <main class="bg-grey min-h-screen w-full overflow-visible">
        <LoginForm client:load lang={lang} session={session} />
    </main>
</Layout>
