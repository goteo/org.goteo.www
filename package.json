{
  "name": "goteo",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "pnpm check:format:prettier",
    "check:format:prettier": "prettier --check . --plugin prettier-plugin-astro --plugin prettier-plugin-svelte",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:verify": "cypress verify",
    "db:migrate": "wrangler d1 migrations apply goteo-db --local",
    "db:seed": "wrangler d1 execute goteo-db --local --file=./db/seed.sql",
    "dev": "astro dev",
    "dev:worker": "npx astro build && npx wrangler dev --port 4321 --ip 0.0.0.0",
    "format": "eslint --fix . && prettier --write .",
    "format:eslint": "eslint --fix . ",
    "format:prettier": "prettier --write .",
    "openapi": "openapi-ts",
    "preview": "astro preview",
    "preview:ci": "NODE_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 SKIP_PAYMENT_GATEWAYS=true PAYMENT_GATEWAYS_ENABLED=false wrangler dev --env preview --port 4321 --ip 0.0.0.0",
    "test:e2e": "start-server-and-test dev http://localhost:4321 cypress:run",
    "test:e2e:ci": "NODE_TLS_REJECT_UNAUTHORIZED=0 start-server-and-test preview:ci http://localhost:4321 cypress:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/node": "^9.5.5",
    "@astrojs/svelte": "^7.2.5",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@fontsource/karla": "^5.3.0",
    "@hey-api/client-fetch": "^0.11.0",
    "@internationalized/date": "^3.12.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/static-renderer": "3.28.0",
    "@types/iso-3166-2": "^1.0.4",
    "astro": "^5.18.2",
    "bits-ui": "^2.18.1",
    "chart.js": "^4.5.1",
    "csrf": "^3.1.0",
    "dexie": "^4.4.2",
    "dinero.js": "^2.0.2",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "flickity": "^3.0.0",
    "iso-3166-2": "^1.0.0",
    "marked": "^18.0.6",
    "media-icons": "^1.1.5",
    "murmurhash-js": "^1.0.0",
    "svelte": "^5.56.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.69.2",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/svelte-vite": "^10.5.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cypress": "^15.18.1",
    "eslint": "^10.0.1",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.5.2",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "1.5.2",
    "flowbite-svelte-icons": "^2.3.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.11",
    "storybook": "^10.5.2",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-range-slider-pips": "^4.1.1",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10",
    "wrangler": "^4.112.0"
  }
}
